            apiVersion: policy.open-cluster-management.io/v1beta1
            kind: OperatorPolicy
            metadata:
              annotations:
                description: Operator policy for OpenShift ADP
              name: install-oadp
            spec:
              complianceType: musthave
              operatorGroup:
                name: openshift-adp-group
                namespace: openshift-adp
                targetNamespaces:
                  - openshift-adp
              remediationAction: enforce
              severity: high
              subscription:
                channel: stable
                name: redhat-oadp-operator
                namespace: openshift-adp
                source: redhat-operators
                sourceNamespace: openshift-marketplace
              upgradeApproval: Automatic
      remediationAction: enforce
  4: |
    apiVersion: policy.open-cluster-management.io/v1
    kind: Policy
    metadata:
      annotations:
        policy.open-cluster-management.io/categories: CM Configuration Management
        policy.open-cluster-management.io/controls: CM-2 Baseline Configuration
        policy.open-cluster-management.io/standards: NIST SP 800-53
      name: shapes-test
      namespace: open-cluster-management
    spec:
      copyPolicyMetadata: false
      disabled: false
      policy-templates:
        - objectDefinition:
            apiVersion: policy.open-cluster-management.io/v1
            kind: ConfigurationPolicy
            metadata:
              name: shapes-acm-first
            spec:
              object-templates-raw: |
                {{- range $ns := (lookup "v1" "Namespace" "" "").items }}
                - complianceType: musthave
                  objectDefinition:
                    apiVersion: v1
                    kind: Namespace
                    metadata:
                      name: {{ $ns.metadata.name }}
                {{- end }}
              remediationAction: enforce
              severity: low
        - objectDefinition:
            apiVersion: policy.open-cluster-management.io/v1
            kind: ConfigurationPolicy
            metadata:
              name: shapes-empty
            spec:
              object-templates-raw: |
                []
              remediationAction: enforce
              severity: low
        - objectDefinition:
            apiVersion: policy.open-cluster-management.io/v1
            kind: ConfigurationPolicy
            metadata:
              name: shapes-list
            spec:
              object-templates:
                - complianceType: musthave
                  objectDefinition:
                    apiVersion: v1
                    data:
                      value1: element
                    kind: ConfigMap
                    metadata:
                      name: element-cm
                      namespace: default
                - complianceType: musthave
                  objectDefinition:
                    apiVersion: v1
                    kind: Namespace
                    metadata:
                      name: multi-a
              remediationAction: enforce
              severity: low
        - objectDefinition:
            apiVersion: policy.open-cluster-management.io/v1
            kind: ConfigurationPolicy
            metadata:
              name: shapes-multi
            spec:
              object-templates:
                - complianceType: musthave
                  objectDefinition:
                    apiVersion: v1
                    kind: Namespace
                    metadata:
                      name: multi-a
                - complianceType: musthave
                  objectDefinition:
                    apiVersion: v1
                    data:
                      key: a---b
                    kind: ConfigMap
                    metadata:
                      name: multi-b
                      namespace: multi-a
              remediationAction: enforce
              severity: low
        - objectDefinition:
            apiVersion: policy.open-cluster-management.io/v1
            kind: ConfigurationPolicy
            metadata:
              name: shapes-partial
            spec:
              object-templates:
                - complianceType: musthave
                  objectDefinition:
                    apiVersion: v1
                    kind: ConfigMap
                    metadata:
                      name: note
                      namespace: default
              remediationAction: enforce
              severity: low
        - objectDefinition:
            apiVersion: policy.open-cluster-management.io/v1
            kind: ConfigurationPolicy
            metadata:
              name: shapes-raw-list
            spec:
              object-templates-raw: |
                - complianceType: musthave
                  objectDefinition:
                    apiVersion: machine.openshift.io/v1beta1
                    kind: MachineSet
                    metadata:
                      name: {{ (lookup "config.openshift.io/v1" "Infrastructure" "" "cluster").status.infrastructureName }}-worker-a
                      namespace: openshift-machine-api
                    spec:
                      replicas: 1
              remediationAction: enforce
              severity: low
        - objectDefinition:
            apiVersion: policy.open-cluster-management.io/v1
            kind: ConfigurationPolicy
            metadata:
              name: shapes-single
            spec:
              object-templates:
                - complianceType: musthave
                  objectDefinition:
                    apiVersion: v1
                    data:
                      value1: element
                    kind: ConfigMap
                    metadata:
                      name: element-cm
                      namespace: default
              remediationAction: enforce
              severity: low
      remediationAction: enforce
  5: |
    apiVersion: cluster.open-cluster-management.io/v1beta1
    kind: Placement
    metadata:
      name: test
      namespace: open-cluster-management
    spec:
      predicates:
        - requiredClusterSelector:
            labelSelector:
              matchExpressions:
                - key: environment
                  operator: In
                  values:
                    - dev
      tolerations:
        - key: cluster.open-cluster-management.io/unreachable
          operator: Exists
        - key: cluster.open-cluster-management.io/unavailable
          operator: Exists
  6: |
    apiVersion: policy.open-cluster-management.io/v1
    kind: PlacementBinding
    metadata:
      name: test
      namespace: open-cluster-management
    placementRef:
      apiGroup: cluster.open-cluster-management.io
      kind: Placement
      name: test
    subjects:
      - apiGroup: policy.open-cluster-management.io
        kind: Policy
        name: base-test
      - apiGroup: policy.open-cluster-management.io
        kind: Policy
        name: certs-test
      - apiGroup: policy.open-cluster-management.io
        kind: Policy
        name: install-test
      - apiGroup: policy.open-cluster-management.io
        kind: Policy
        name: shapes-test
  7: |
    apiVersion: policy.open-cluster-management.io/v1beta1
    kind: PolicySet
    metadata:
      name: baseline-test
      namespace: open-cluster-management
    spec:
      policies:
        - base-test
        - certs-test
