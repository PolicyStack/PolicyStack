{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "release-as": "1.0.0-rc.2",
      "exclude-paths": [
        ".release-please",
        "docs",
        "diagrams",
        "values",
        "lib/tests",
        "tools/validator/testdata/clusters",
        "tools/validator/testdata/profiles"
      ],
      "extra-files": [
        {
          "type": "generic",
          "path": "install/Chart.yaml"
        },
        {
          "type": "generic",
          "path": "lifecycle/Chart.yaml"
        }
      ]
    }
  }
}
