{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "cidr": {"type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"},
    "cidrs": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/cidr"}},
    "vips": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string", "pattern": "^[0-9a-fA-F:.]+$"}},
    "mac": {"type": "string", "pattern": "^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$"},
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bmcAddress", "bootMACAddress"],
      "properties": {
        "role": {"enum": ["master", "worker", "arbiter"]},
        "bmcAddress": {"type": "string", "pattern": "^((redfish|idrac|ilo5)-virtualmedia(\\+https?)?|ilo4-virtualmedia(\\+https)?)://[^/]+"},
        "bootMACAddress": {"$ref": "#/definitions/mac"},
        "rootDeviceHints": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "deviceName": {"type": "string", "pattern": "^/dev/(disk/by-path/)?[^/]+$"},
            "hctl": {"type": "string"},
            "model": {"type": "string"},
            "vendor": {"type": "string"},
            "serialNumber": {"type": "string"},
            "minSizeGigabytes": {"type": "integer", "minimum": 0},
            "wwn": {"type": "string"},
            "wwnWithExtension": {"type": "string"},
            "wwnVendorExtension": {"type": "string"},
            "rotational": {"type": "boolean"}
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["interfaces", "config"],
          "properties": {
            "interfaces": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/definitions/mac"}},
            "config": {"type": "object"}
          }
        },
        "remove": {"const": true}
      },
      "if": {"required": ["remove"]},
      "then": {"required": ["role"], "properties": {"role": {"const": "worker"}}}
    }
  },
  "properties": {
    "hub": {"type": "string"},
    "state": {"enum": ["present", "absent"]},
    "version": {"type": "string", "pattern": "^$|^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.]+)?$"},
    "channel": {"type": "string"},
    "install": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {"enum": ["hypershift", "hive", "siteconfig"]},
        "platform": {"enum": ["", "KubeVirt", "Agent", "None"]},
        "releaseRepository": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1},
        "credential": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespace": {"type": "string"},
            "name": {"type": "string"}
          }
        },
        "baseDomain": {"type": "string"},
        "agentNamespace": {"type": "string"},
        "services": {"type": "object", "additionalProperties": {"type": ["object", "null"]}},
        "hostedCluster": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "metadata": {"type": "object"},
            "spec": {"type": "object"}
          }
        },
        "nodePools": {"type": "object", "additionalProperties": {"type": "object"}},
        "manifests": {
          "type": "array",
          "items": {"type": "object", "required": ["apiVersion", "kind", "metadata"]}
        },
        "hive": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "platform": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "maxProperties": 1,
              "properties": {
                "aws": {"type": "object", "required": ["region"]},
                "gcp": {"type": "object", "required": ["region", "projectID"]},
                "azure": {"type": "object", "required": ["region", "baseDomainResourceGroupName"]},
                "vsphere": {
                  "type": "object",
                  "required": ["vcenters", "failureDomains"],
                  "propertyNames": {"not": {"enum": ["username", "password"]}},
                  "properties": {
                    "vcenters": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 3,
                      "items": {"type": "object", "required": ["server"], "propertyNames": {"not": {"enum": ["user", "password"]}}}
                    },
                    "failureDomains": {"type": "array", "minItems": 1}
                  }
                }
              }
            },
            "installConfig": {"type": "object"},
            "clusterDeployment": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "metadata": {"type": "object"},
                "spec": {"type": "object"}
              }
            }
          }
        },
        "siteconfig": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "templates": {"enum": ["ai", "ibi"]},
            "templateNamespace": {"type": "string", "minLength": 1},
            "bmcCredential": {
              "type": "object",
              "additionalProperties": false,
              "required": ["namespace", "name"],
              "properties": {
                "namespace": {"type": "string", "minLength": 1},
                "name": {"type": "string", "minLength": 1}
              }
            },
            "machineNetwork": {"$ref": "#/definitions/cidrs"},
            "apiVIPs": {"$ref": "#/definitions/vips"},
            "ingressVIPs": {"$ref": "#/definitions/vips"},
            "clusterNetwork": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["cidr", "hostPrefix"],
                "properties": {
                  "cidr": {"$ref": "#/definitions/cidr"},
                  "hostPrefix": {"type": "integer", "minimum": 1, "maximum": 128}
                }
              }
            },
            "serviceNetwork": {"$ref": "#/definitions/cidrs"},
            "ntpSources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "proxy": {
              "type": "object",
              "additionalProperties": false,
              "anyOf": [{"required": ["httpProxy"]}, {"required": ["httpsProxy"]}],
              "properties": {
                "httpProxy": {"type": "string", "minLength": 1},
                "httpsProxy": {"type": "string", "minLength": 1},
                "noProxy": {"type": "string", "minLength": 1}
              }
            },
            "extraManifests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "nodes": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {"maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"},
              "additionalProperties": {"$ref": "#/definitions/node"}
            }
          },
          "if": {"required": ["templates"], "properties": {"templates": {"const": "ibi"}}},
          "then": {
            "not": {"anyOf": [{"required": ["apiVIPs"]}, {"required": ["ingressVIPs"]}, {"required": ["clusterNetwork"]}, {"required": ["serviceNetwork"]}]},
            "properties": {
              "nodes": {
                "maxProperties": 1,
                "additionalProperties": {"not": {"required": ["remove"]}}
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"engine": {"const": "hive"}}},
          "then": {"properties": {"hive": {"required": ["platform"]}}},
          "else": {"properties": {"hive": {"maxProperties": 0}}}
        },
        {
          "if": {"properties": {"engine": {"const": "siteconfig"}}},
          "then": {"properties": {"siteconfig": {"required": ["bmcCredential", "nodes"]}}},
          "else": {"properties": {"siteconfig": {"maxProperties": 0}}}
        }
      ]
    }
  }
}
