1.2.0 dependencies and ordering:
  1: |
    apiVersion: policy.open-cluster-management.io/v1
    kind: Policy
    metadata:
      annotations:
        description: Baseline policy
        policy.open-cluster-management.io/categories: CM Configuration Management
        policy.open-cluster-management.io/controls: CM-2 Baseline Configuration
        policy.open-cluster-management.io/standards: NIST SP 800-53
      name: base-test
      namespace: open-cluster-management
    spec:
      copyPolicyMetadata: false
      disabled: false
      policy-templates:
        - objectDefinition:
            apiVersion: policy.open-cluster-management.io/v1
            kind: ConfigurationPolicy
            metadata:
              annotations:
                description: Test ConfigMap
              name: base-test-cm
            spec:
              object-templates:
                - complianceType: musthave
                  objectDefinition:
                    apiVersion: v1
                    data:
                      value1: hello
                    kind: ConfigMap
                    metadata:
                      name: testcm
                      namespace: default
              remediationAction: enforce
              severity: medium
      remediationAction: enforce
  2: |
    apiVersion: policy.open-cluster-management.io/v1
    kind: Policy
    metadata:
      annotations:
        policy.open-cluster-management.io/categories: CM Configuration Management
        policy.open-cluster-management.io/controls: CM-2 Baseline Configuration
        policy.open-cluster-management.io/standards: NIST SP 800-53
      name: certs-test
      namespace: open-cluster-management
    spec:
      copyPolicyMetadata: false
      disabled: false
      policy-templates:
        - objectDefinition:
            apiVersion: policy.open-cluster-management.io/v1
            kind: ConfigurationPolicy
            metadata:
              name: certs-bundle
            spec:
              object-templates:
                - complianceType: musthave
                  objectDefinition:
                    apiVersion: v1
                    kind: ConfigMap
                    metadata:
                      labels:
                        config.openshift.io/inject-trusted-cabundle: "true"
                      name: trusted-ca
                      namespace: openshift-config
              remediationAction: inform
              severity: low
      remediationAction: inform
  3: |
    apiVersion: policy.open-cluster-management.io/v1
    kind: Policy
    metadata:
      annotations:
        policy.open-cluster-management.io/categories: CM Configuration Management
        policy.open-cluster-management.io/controls: CM-2 Baseline Configuration
        policy.open-cluster-management.io/standards: NIST SP 800-53
      name: install-test
      namespace: open-cluster-management
    spec:
      copyPolicyMetadata: false
      disabled: false
      policy-templates:
        - objectDefinition:
            apiVersion: policy.open-cluster-management.io/v1
            kind: ConfigurationPolicy
            metadata:
              name: install-oadp-ns
            spec:
              object-templates:
                - complianceType: musthave
                  objectDefinition:
                    apiVersion: v1
                    kind: Namespace
                    metadata:
                      name: openshift-adp
              remediationAction: enforce
              severity: low
        - objectDefinition:
            apiVersion: policy.open-cluster-management.io/v1
            kind: ConfigurationPolicy
            metadata:
              name: install-oadp-status
            spec:
              object-templates:
                - complianceType: musthave
                  objectDefinition:
                    apiVersion: operators.coreos.com/v1alpha1
                    kind: ClusterServiceVersion
                    metadata:
                      namespace: openshift-adp
                    spec:
                      displayName: OADP Operator
                    status:
                      phase: Succeeded
              remediationAction: inform
              severity: low
        - ignorePending: true
          objectDefinition:
            apiVersion: policy.open-cluster-management.io/v1beta1
            kind: OperatorPolicy
            metadata:
              annotations:
                description: Operator policy for OpenShift ADP
              name: install-oadp
            spec:
              complianceType: musthave
              operatorGroup:
                name: openshift-adp-group
                namespace: openshift-adp
                targetNamespaces:
                  - openshift-adp
              remediationAction: enforce
              severity: low
              subscription:
                channel: stable
                name: redhat-oadp-operator
                namespace: openshift-adp
                source: redhat-operators
                sourceNamespace: openshift-marketplace
              upgradeApproval: Automatic
      remediationAction: enforce
  4: |
    apiVersion: policy.open-cluster-management.io/v1
    kind: Policy
    metadata:
      annotations:
        policy.open-cluster-management.io/categories: CM Configuration Management
        policy.open-cluster-management.io/controls: CM-2 Baseline Configuration
        policy.open-cluster-management.io/standards: NIST SP 800-53
      name: workloads-test
      namespace: open-cluster-management
    spec:
      copyPolicyMetadata: false
      dependencies:
        - apiVersion: policy.open-cluster-management.io/v1
          compliance: Compliant
          kind: Policy
          name: cluster-bootstrap-platform-base
          namespace: open-cluster-management
        - apiVersion: policy.open-cluster-management.io/v1
          compliance: Compliant
          kind: Policy
          name: hand-made-policy
          namespace: open-cluster-management
      disabled: false
      policy-templates:
        - extraDependencies:
            - apiVersion: policy.open-cluster-management.io/v1
              compliance: Compliant
              kind: ConfigurationPolicy
              name: install-oadp-status
            - apiVersion: policy.open-cluster-management.io/v1beta1
              compliance: Compliant
              kind: OperatorPolicy
              name: install-oadp
            - apiVersion: policy.open-cluster-management.io/v1
              compliance: Compliant
              kind: Policy
              name: some-prereq-policy-test
              namespace: open-cluster-management
          ignorePending: true
          objectDefinition:
            apiVersion: policy.open-cluster-management.io/v1
            kind: ConfigurationPolicy
            metadata:
              name: workloads-dpa
            spec:
              object-templates:
                - complianceType: musthave
                  objectDefinition:
                    apiVersion: v1
                    data:
                      value1: dpa
                    kind: ConfigMap
                    metadata:
                      name: dpa-cm
                      namespace: default
              remediationAction: enforce
              severity: low
        - extraDependencies:
            - apiVersion: policy.open-cluster-management.io/v1
              compliance: Compliant
              kind: ConfigurationPolicy
              name: workloads-dpa
          objectDefinition:
            apiVersion: policy.open-cluster-management.io/v1
            kind: ConfigurationPolicy
            metadata:
              name: workloads-followup
            spec:
              object-templates:
                - complianceType: musthave
                  objectDefinition:
                    apiVersion: v1
                    data:
                      value1: unset
                    kind: ConfigMap
                    metadata:
                      name: test-cm
                      namespace: default
              remediationAction: enforce
              severity: low
      remediationAction: enforce
  5: |
    apiVersion: cluster.open-cluster-management.io/v1beta1
    kind: Placement
    metadata:
      name: test
      namespace: open-cluster-management
    spec:
      predicates:
        - requiredClusterSelector:
            labelSelector:
              matchExpressions:
                - key: environment
                  operator: In
                  values:
                    - dev
      tolerations:
        - key: cluster.open-cluster-management.io/unreachable
          operator: Exists
        - key: cluster.open-cluster-management.io/unavailable
          operator: Exists
  6: |
    apiVersion: policy.open-cluster-management.io/v1
    kind: PlacementBinding
    metadata:
      name: test
      namespace: open-cluster-management
    placementRef:
      apiGroup: cluster.open-cluster-management.io
      kind: Placement
      name: test
    subjects:
      - apiGroup: policy.open-cluster-management.io
        kind: Policy
        name: base-test
      - apiGroup: policy.open-cluster-management.io
        kind: Policy
        name: certs-test
      - apiGroup: policy.open-cluster-management.io
        kind: Policy
        name: install-test
      - apiGroup: policy.open-cluster-management.io
        kind: Policy
        name: workloads-test
  7: |
    apiVersion: policy.open-cluster-management.io/v1beta1
    kind: PolicySet
    metadata:
      name: baseline-test
      namespace: open-cluster-management
    spec:
      policies:
        - base-test
        - certs-test
