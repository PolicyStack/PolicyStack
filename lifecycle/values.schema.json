{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "hub": {"type": "string"},
    "state": {"enum": ["present", "absent"]},
    "version": {"type": "string", "pattern": "^$|^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.]+)?$"},
    "channel": {"type": "string"},
    "install": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {"enum": ["hypershift", "hive"]},
        "platform": {"enum": ["", "KubeVirt", "Agent", "None"]},
        "releaseRepository": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1},
        "credential": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespace": {"type": "string"},
            "name": {"type": "string"}
          }
        },
        "baseDomain": {"type": "string"},
        "agentNamespace": {"type": "string"},
        "services": {"type": "object", "additionalProperties": {"type": ["object", "null"]}},
        "hostedCluster": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "metadata": {"type": "object"},
            "spec": {"type": "object"}
          }
        },
        "nodePools": {"type": "object", "additionalProperties": {"type": "object"}},
        "manifests": {
          "type": "array",
          "items": {"type": "object", "required": ["apiVersion", "kind", "metadata"]}
        },
        "hive": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "platform": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "maxProperties": 1,
              "properties": {
                "aws": {"type": "object", "required": ["region"]},
                "gcp": {"type": "object", "required": ["region", "projectID"]},
                "azure": {"type": "object", "required": ["region", "baseDomainResourceGroupName"]}
              }
            },
            "installConfig": {"type": "object"},
            "clusterDeployment": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "metadata": {"type": "object"},
                "spec": {"type": "object"}
              }
            }
          }
        }
      },
      "if": {"properties": {"engine": {"const": "hive"}}},
      "then": {"properties": {"hive": {"required": ["platform"]}}},
      "else": {"properties": {"hive": {"maxProperties": 0}}}
    }
  }
}
