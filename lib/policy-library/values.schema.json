{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "policy-library",
  "description": "Validates .Values.stack when the consuming chart sets alias: stack on this dependency. Each key is a component, keyed by the consuming chart's camelCased name.",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "remediationAction": {
          "type": ["string", "null"],
          "enum": ["inform", "", null],
          "description": "Sets remediationAction: inform on every Policy, overriding each template. enforce is not accepted: it would also enforce templates that must only inform."
        },
        "catalogSources": {
          "type": ["object", "null"],
          "additionalProperties": { "type": ["string", "null"] },
          "description": "Maps an operatorPolicies subscription.source to the CatalogSource to use instead."
        }
      }
    }
  },
  "additionalProperties": { "$ref": "#/definitions/component" },
  "definitions": {
    "stringOrList": { "type": ["string", "array", "null"], "items": { "type": ["string", "null"] } },
    "stringList": { "type": ["array", "null"], "items": { "type": ["string", "null"] } },
    "dependencies": {
      "type": ["array", "null"],
      "items": {
        "type": ["object", "null"],
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": ["string", "null"] },
          "kind": { "type": ["string", "null"] },
          "compliance": { "type": ["string", "null"] },
          "policyRef": { "type": ["string", "null"] },
          "release": { "type": ["string", "null"] },
          "element": { "type": ["string", "null"] },
          "raw": { "type": ["boolean", "null"] },
          "namespace": { "type": ["string", "null"] },
          "apiVersion": { "type": ["string", "null"] }
        }
      }
    },
    "compliantPair": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": { "compliant": { "type": ["string", "null"] }, "noncompliant": { "type": ["string", "null"] } }
    },
    "component": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": ["boolean", "null"] },
        "config": {
          "type": ["object", "null"],
          "description": "Element settings, read by its converters as .Config; not validated here."
        },
        "default": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "remediationAction": {
              "type": ["string", "null"],
              "enum": ["inform", "enforce", "", null],
              "description": "Action of every Policy that sets none. inform when omitted."
            },
            "severity": {
              "type": ["string", "null"],
              "description": "Severity of every entry that sets none. low when omitted."
            },
            "categories": { "$ref": "#/definitions/stringList" },
            "controls": { "$ref": "#/definitions/stringList" },
            "standards": { "$ref": "#/definitions/stringList" }
          }
        },
        "disablePlacements": { "type": ["boolean", "null"] },
        "usePolicySetsPlacements": { "type": ["boolean", "null"] },
        "suffixTemplateNames": { "type": ["boolean", "null"] },
        "policies": {
          "type": ["object", "null"],
          "description": "Keyed by policy name. converters/<name>/ holds its templates.",
          "additionalProperties": { "$ref": "#/definitions/policy" }
        },
        "operatorPolicies": { "type": ["object", "null"], "additionalProperties": { "$ref": "#/definitions/operatorPolicy" } },
        "policySets": { "type": ["array", "null"], "items": { "$ref": "#/definitions/policySet" } }
      }
    },
    "policy": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": ["boolean", "null"] },
        "description": { "type": ["string", "null"] },
        "categories": { "$ref": "#/definitions/stringList" },
        "controls": { "$ref": "#/definitions/stringList" },
        "standards": { "$ref": "#/definitions/stringList" },
        "severity": { "type": ["string", "null"] },
        "remediationAction": { "type": ["string", "null"], "enum": ["inform", "enforce", "", null] },
        "disabled": { "type": ["boolean", "null"] },
        "dependencies": { "$ref": "#/definitions/dependencies" },
        "orderManifests": {
          "$ref": "#/definitions/stringList",
          "description": "Templates that render first, in this order. Every template and operator of the Policy then waits for the one before it."
        },
        "hubTemplateOptions": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": { "serviceAccountName": { "type": ["string", "null"] } }
        },
        "templates": {
          "type": ["object", "null"],
          "description": "Keyed by template name: converters/<policy>/<name>.yaml.",
          "additionalProperties": { "$ref": "#/definitions/template" }
        }
      }
    },
    "template": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": ["boolean", "null"] },
        "description": { "type": ["string", "null"] },
        "customMessage": { "$ref": "#/definitions/compliantPair" },
        "evaluationInterval": { "$ref": "#/definitions/compliantPair" },
        "namespaceSelector": { "type": ["object", "null"] },
        "disableTemplating": { "type": ["boolean", "null"] },
        "severity": { "type": ["string", "null"] },
        "remediationAction": {
          "type": ["string", "null"],
          "enum": ["InformOnly", "", null],
          "description": "InformOnly keeps the template inform under an enforce Policy. Otherwise it takes the Policy's action."
        },
        "complianceType": { "type": ["string", "null"] },
        "pruneObjectBehavior": { "type": ["string", "null"] },
        "extraDependencies": { "$ref": "#/definitions/dependencies" },
        "waitForOperator": { "$ref": "#/definitions/stringOrList" },
        "ignorePending": { "type": ["boolean", "null"] },
        "metadataComplianceType": { "type": ["string", "null"] },
        "recordDiff": { "type": ["string", "null"] },
        "recreateOption": { "type": ["string", "null"] },
        "objectSelector": { "type": ["object", "null"] },
        "file": {
          "$ref": "#/definitions/stringOrList",
          "description": "Path under converters/ without .yaml, or a list of them; replaces converters/<policy>/<name>.yaml."
        },
        "config": {
          "type": ["object", "null"],
          "description": "Merged over the element's config for this template's .Config."
        }
      }
    },
    "operatorPolicy": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": ["boolean", "null"] },
        "description": { "type": ["string", "null"] },
        "severity": { "type": ["string", "null"] },
        "complianceType": { "type": ["string", "null"] },
        "namespace": { "type": ["string", "null"] },
        "displayName": { "type": ["string", "null"] },
        "versions": { "$ref": "#/definitions/stringList" },
        "operatorGroup": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": ["string", "null"] },
            "targetNamespaces": { "$ref": "#/definitions/stringList" }
          }
        },
        "subscription": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": ["string", "null"] },
            "channel": { "type": ["string", "null"] },
            "source": { "type": ["string", "null"] },
            "sourceNamespace": { "type": ["string", "null"] },
            "startingCSV": { "type": ["string", "null"] },
            "config": { "type": ["object", "null"] }
          }
        },
        "upgradeApproval": { "type": ["string", "null"] },
        "removalBehavior": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "operatorGroups": { "type": ["string", "null"] },
            "subscriptions": { "type": ["string", "null"] },
            "clusterServiceVersions": { "type": ["string", "null"] },
            "customResourceDefinitions": { "type": ["string", "null"] }
          }
        },
        "extraDependencies": { "$ref": "#/definitions/dependencies" },
        "waitForOperator": { "$ref": "#/definitions/stringOrList" },
        "ignorePending": { "type": ["boolean", "null"] },
        "clusterMonitoring": {
          "type": ["boolean", "null"],
          "description": "Labels the namespace openshift.io/cluster-monitoring=true."
        }
      }
    },
    "policySet": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": ["string", "null"] },
        "enabled": { "type": ["boolean", "null"] },
        "description": { "type": ["string", "null"] },
        "policies": { "$ref": "#/definitions/stringList" }
      }
    }
  }
}
