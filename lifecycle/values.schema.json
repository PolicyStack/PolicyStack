{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "hub": {"type": "string"},
    "state": {"enum": ["present", "absent"]},
    "version": {"type": "string", "pattern": "^$|^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.]+)?$"},
    "channel": {"type": "string"},
    "install": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {"enum": ["hypershift"]},
        "platform": {"enum": ["", "KubeVirt", "Agent", "None"]},
        "releaseRepository": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1},
        "credential": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespace": {"type": "string"},
            "name": {"type": "string"}
          }
        },
        "baseDomain": {"type": "string"},
        "agentNamespace": {"type": "string"},
        "services": {"type": "object", "additionalProperties": {"type": ["object", "null"]}},
        "hostedCluster": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "metadata": {"type": "object"},
            "spec": {"type": "object"}
          }
        },
        "nodePools": {"type": "object", "additionalProperties": {"type": "object"}},
        "manifests": {
          "type": "array",
          "items": {"type": "object", "required": ["apiVersion", "kind", "metadata"]}
        }
      }
    }
  }
}
